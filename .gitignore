# Runtime JSON documents (assistant state, memory stores, business records) and
# their lock, reclaim, quarantine, and audit sidecars. Atomic temps are dot-prefixed.
typescript/data/jarvis-*.json*
typescript/data/.jarvis-*.json.tmp-*

# Temporal PASS prototype (src/preview/temporalPass) local idempotency/mock-repo state
typescript/data/preview/temporal-pass-idempotency.json*
typescript/data/preview/temporal-pass-mock-repo.json*
typescript/data/preview/.temporal-pass-*.tmp-*
typescript/data/preview/*.lock

# TypeScript dependencies and generated output
/typescript/node_modules/
/typescript/dist/
/typescript/**/dist/
*.tsbuildinfo

# Removed scaffolds / accidental local PR-body files
/jarvis-console-01/
/.github/pull_request_update
pr-body.md
pull_request_update

