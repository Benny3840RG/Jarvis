{
  "name": "jarvis-typescript",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "node --import tsx src/http/main.ts",
    "start:mcp": "node --import tsx src/mcp/main.ts",
    "start:preview": "node --import tsx src/preview/main.ts",
    "paddock": "node --import tsx src/tools/runPaddock.ts",
    "agent:check": "node --import tsx src/agent/main.ts",
    "agent:repl": "node --import tsx src/agent/replMain.ts",
    "test": "npm run test:node && npm run test:convex",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.ts && npm run test:convex",
    "type-check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier . --check --ignore-path .prettierignore",
    "format": "prettier . --write --ignore-path .prettierignore",
    "openapi:lint": "redocly lint openapi/jarvis.openapi.json",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run openapi:lint && npm test",
    "smoke:convex": "tsx src/tools/runConvexSmoke.ts",
    "smoke:mcp": "tsx src/tools/runMcpSmoke.ts",
    "smoke:gemini": "tsx src/tools/runGeminiSmoke.ts",
    "backup": "tsx src/tools/runBackup.ts",
    "import:convex": "tsx src/tools/runConvexImport.ts",
    "test:node": "node --import tsx --test tests/*.test.ts",
    "test:convex": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "convex": "^1.42.3",
    "fastify": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@eslint/js": "^9.39.0",
    "@redocly/cli": "^2.39.0",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.0",
    "globals": "^17.4.0",
    "prettier": "^3.9.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.58.0",
    "@edge-runtime/vm": "5.0.0",
    "convex-test": "0.0.54",
    "vitest": "1.6.1"
  },
  "overrides": {
    "find-my-way": "^9.7.0",
    "@hono/node-server": "^2.0.11"
  }
}
