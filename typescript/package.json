{
  "name": "jarvis-typescript",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "node --import tsx src/http/main.ts",
    "start:mcp": "node --import tsx src/mcp/main.ts",
    "start:preview": "node --import tsx src/preview/main.ts",
    "paddock": "node --import tsx src/tools/runPaddock.ts",
    "monitor": "node --import tsx src/tools/runLiveWorkMonitor.ts",
    "owner:approve": "node --import tsx src/tools/runOwnerApproveToolAction.ts",
    "dev:live-work": "node --import tsx src/tools/runLiveWorkDev.ts",
    "quote:demo": "node --import tsx src/tools/runQuoteDemo.ts",
    "quote:create": "node --import tsx src/tools/runQuoteCreate.ts",
    "quotes:list": "node --import tsx src/tools/runQuotesList.ts",
    "quotes:show": "node --import tsx src/tools/runQuotesShow.ts",
    "search": "node --import tsx src/tools/runSearch.ts",
    "agent:check": "node --import tsx src/agent/main.ts",
    "agent:repl": "node --import tsx src/agent/replMain.ts",
    "test": "concurrently -n node,convex -c auto \"npm:test:node\" \"npm:test:convex\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.ts jarvis-console-01/tests/*.test.ts && npm run test:convex",
    "type-check": "tsc -p tsconfig.json && tsc -p convex/tsconfig.json",
    "lint": "eslint . --cache --cache-location .cache/eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslintcache",
    "format:check": "prettier . --check --ignore-path .prettierignore",
    "format": "prettier . --write --ignore-path .prettierignore",
    "openapi:lint": "redocly lint openapi/jarvis.openapi.json",
    "check:hygiene": "node scripts/check-repository-hygiene.mjs",
    "check": "npm run check:hygiene && npm run type-check && npm run check:static && npm test",
    "check:static": "concurrently -n lint,format,openapi -c auto \"npm:lint\" \"npm:format:check\" \"npm:openapi:lint\"",
    "smoke:convex": "tsx src/tools/runConvexSmoke.ts",
    "smoke:mcp": "tsx src/tools/runMcpSmoke.ts",
    "smoke:gemini": "tsx src/tools/runGeminiSmoke.ts",
    "commission:posthog": "node --import tsx src/tools/runPostHogCommissioning.ts",
    "commission:isolated-ingress": "node --import tsx src/tools/runIsolatedIngressCommissioning.ts",
    "commission:sentry": "node --import tsx src/tools/runSentryCommissioning.ts",
    "commission:outlook-quote": "node --import tsx src/tools/runOutlookQuoteCommissioning.ts",
    "backup": "tsx src/tools/runBackup.ts",
    "restore-drill": "tsx src/tools/runRestoreDrill.ts",
    "import:convex": "tsx src/tools/runConvexImport.ts",
    "test:node": "node --import tsx --test tests/*.test.ts jarvis-console-01/tests/*.test.ts",
    "test:convex": "vitest run --config vitest.config.mts --maxWorkers=1",
    "test:temporal-pass": "node --import tsx --test tests/pass/*.test.ts",
    "outlook": "node --import tsx src/tools/runOutlookOnboarding.ts",
    "temporal:readiness": "node --import tsx src/tools/runTemporalReadiness.ts",
    "home:discover": "node --import tsx src/tools/runGoogleHomeDiscovery.ts",
    "home:kit": "node --import tsx src/tools/runGoogleHomeCommissioningKit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@convex-dev/rate-limiter": "^0.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/core": "^2.2.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "bonjour-service": "^1.4.4",
    "castv2-client": "^1.2.0",
    "convex": "1.46.0",
    "fastify": "^5.12.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "text2wav": "^0.0.14",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.57.0",
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^24.19.1",
    "ajv": "^8.20.0",
    "concurrently": "10.0.5",
    "convex-test": "0.0.60",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "@swc/core": true,
    "protobufjs": false
  },
  "overrides": {
    "find-my-way": "^9.7.0",
    "@hono/node-server": "^2.0.11",
    "brace-expansion": "^5.0.12",
    "fast-uri": "^4.2.1",
    "hono": "^4.12.34",
    "ip-address": "^10.7.2",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "concurrently": {
      "shell-quote": "1.11.0"
    },
    "castv2": {
      "protobufjs": "^7.6.6"
    }
  }
}
